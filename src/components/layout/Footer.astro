---
import { appConfig } from '../../lib/config';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#f5f5f7] dark:bg-[#000000] border-t border-black/[0.04] dark:border-white/[0.06] text-[#86868b] dark:text-[#6e6e73] transition-colors duration-200 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- 品牌信息 -->
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center space-x-2.5 mb-3">
          <div class="w-6 h-6 rounded-lg overflow-hidden border border-black/5 dark:border-white/10">
            <img src="/img/APPFUN.webp" alt="APPFUN Logo" class="w-full h-full object-cover" />
          </div>
          <span class="text-base font-bold text-[#1d1d1f] dark:text-[#f5f5f7]">{appConfig.title}</span>
        </div>
        <p class="text-xs leading-relaxed max-w-lg mb-4 text-[#86868b] dark:text-[#6e6e73]">
          免责声明：本站为非营利性技术交流分享平台，所发布的一切软件、补丁及注册信息均来源于互联网，仅供学习交流与技术研究之用。如涉及商业用途，请支持并购买正版授权。
        </p>
        <p class="text-xs text-[#86868b] dark:text-[#6e6e73]">
          版本 {appConfig.version} · 由领创工作室精心打造
        </p>
      </div>

      <!-- 快速导航 -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[#1d1d1f] dark:text-[#f5f5f7] mb-3.5">
          快速导航
        </h3>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="/" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">
              首页发现
            </a>
          </li>
          <li>
            <a href="/software" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">
              全部软件
            </a>
          </li>
          <li>
            <a href="/ranking" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">
              热门排行榜
            </a>
          </li>
          <li>
            <a href="/funhub" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors text-orange-500/90 font-medium">
              FunHub 创意工坊
            </a>
          </li>
        </ul>
      </div>

      <!-- 支持与社区 -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[#1d1d1f] dark:text-[#f5f5f7] mb-3.5">
          支持与社区
        </h3>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="/about" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">
              关于我们
            </a>
          </li>
          <li>
            <a href={appConfig.links.documentation} target="_blank" rel="noopener noreferrer" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">
              API 开放平台
            </a>
          </li>
          <li>
            <a href={appConfig.links.github} target="_blank" rel="noopener noreferrer" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">
              GitHub 开源仓库
            </a>
          </li>
          <li>
            <a href="/sitemap" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">
              网站地图
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- 底部分隔线与备案信息 -->
    <div class="border-t border-black/[0.04] dark:border-white/[0.06] pt-6">
      <div class="flex flex-col md:flex-row justify-between items-center text-xs space-y-4 md:space-y-0">
        <!-- 版权所有 -->
        <div>
          © 2025-{currentYear} 领创工作室. 保留所有权利.
        </div>

        <!-- 备案信息 -->
        <div class="flex flex-wrap items-center justify-center gap-4 text-xs">
          <a href="https://beian.miit.gov.cn/" rel="noreferrer" target="_blank" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors flex items-center">
            辽ICP备2025056705号-3
          </a>
          <span class="text-black/10 dark:text-white/10">|</span>
          <a href="https://beian.mps.gov.cn/#/query/webSearch?code=21122402000211" rel="noreferrer" target="_blank" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors flex items-center">
            辽公网安备21122402000211号
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
