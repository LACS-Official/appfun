---
import Layout from "../layouts/Layout.astro";
import LoadingSpinner from "../components/ui/LoadingSpinner.astro";
import ErrorMessage from "../components/ui/ErrorMessage.astro";
import Badge from "../components/ui/Badge.astro";

// SEO 元数据
const title = "软件排行榜";
const description =
  "查看APPFUN上最受欢迎的软件排行榜。发现下载量最高、评分最好的热门软件，快速找到优质工具";
const keywords =
  "软件排行榜,热门软件,软件排名,最受欢迎软件,软件下载排行,APPFUN";
const canonical = "https://appfun.lacs.cc/ranking";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description: description,
  url: canonical,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: 0,
    itemListElement: [],
  },
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  structuredDataType="website"
  structuredData={structuredData}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <!-- 页面标题 -->
    <div class="mb-10 text-center sm:text-left">
      <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-semibold bg-[#e8f2fc] text-[#0071e3] dark:bg-[#2997ff]/15 dark:text-[#2997ff] mb-3">
        热度风向标
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7]">
        软件排行榜
      </h1>
      <p class="text-sm text-[#86868b] dark:text-[#a1a1a6] mt-1.5">
        依据用户浏览量与下载热度实时统计的最受欢迎软件
      </p>
    </div>

    <!-- 筛选和排序 -->
    <div class="bg-white dark:bg-[#161617] rounded-3xl border border-black/[0.04] dark:border-white/[0.06] shadow-[0_4px_24px_-2px_rgba(0,0,0,0.04)] p-6 mb-8 transition-colors">
      <div class="flex flex-col sm:flex-row gap-4 items-end">
        <!-- 时间范围 -->
        <div class="flex-1 w-full">
          <label
            for="time-range"
            class="block text-xs font-semibold text-[#515154] dark:text-[#a1a1a6] mb-2"
          >
            时间周期
          </label>
          <select
            id="time-range"
            class="w-full rounded-full border border-black/10 dark:border-white/10 bg-black/[0.03] dark:bg-white/[0.06] px-4 py-2.5 text-xs text-[#1d1d1f] dark:text-[#f5f5f7] focus:outline-none focus:ring-2 focus:ring-[#0071e3]/30"
          >
            <option value="all">全部时间</option>
            <option value="today">今日精选</option>
            <option value="week">本周热门</option>
            <option value="month">本月焦点</option>
            <option value="year">年度最佳</option>
          </select>
        </div>

        <!-- 最小浏览量 -->
        <div class="flex-1 w-full">
          <label
            for="min-views"
            class="block text-xs font-semibold text-[#515154] dark:text-[#a1a1a6] mb-2"
          >
            最小热度
          </label>
          <input
            type="number"
            id="min-views"
            placeholder="例如: 100"
            class="w-full rounded-full border border-black/10 dark:border-white/10 bg-black/[0.03] dark:bg-white/[0.06] px-4 py-2 text-xs text-[#1d1d1f] dark:text-[#f5f5f7] placeholder-[#86868b] focus:outline-none focus:ring-2 focus:ring-[#0071e3]/30"
          />
        </div>

        <!-- 应用筛选按钮 -->
        <div class="w-full sm:w-auto">
          <button id="apply-filters" class="w-full sm:w-auto px-6 py-2.5 rounded-full bg-[#0071e3] hover:bg-[#0077ed] text-white text-xs font-semibold shadow-sm hover:scale-[1.02] active:scale-[0.98] transition-all duration-200">
            应用筛选
          </button>
        </div>
      </div>
    </div>

    <!-- 统计信息 -->
    <div
      id="ranking-stats"
      class="hidden grid grid-cols-1 md:grid-cols-3 gap-6 mb-10"
    >
      <div
        class="bg-white dark:bg-[#161617] p-6 rounded-3xl border border-black/[0.04] dark:border-white/[0.06] shadow-[0_4px_24px_-2px_rgba(0,0,0,0.04)]"
      >
        <div
          class="text-xs font-semibold text-[#86868b] dark:text-[#a1a1a6] uppercase tracking-wider mb-2"
        >
          收录软件总数
        </div>
        <div
          class="text-3xl font-black text-[#1d1d1f] dark:text-[#f5f5f7]"
          id="total-software"
        >
          -
        </div>
      </div>
      <div
        class="bg-white dark:bg-[#161617] p-6 rounded-3xl border border-black/[0.04] dark:border-white/[0.06] shadow-[0_4px_24px_-2px_rgba(0,0,0,0.04)]"
      >
        <div
          class="text-xs font-semibold text-[#86868b] dark:text-[#a1a1a6] uppercase tracking-wider mb-2"
        >
          累计总浏览量
        </div>
        <div
          class="text-3xl font-black text-[#1d1d1f] dark:text-[#f5f5f7]"
          id="total-views"
        >
          -
        </div>
      </div>
      <div
        class="bg-white dark:bg-[#161617] p-6 rounded-3xl border border-black/[0.04] dark:border-white/[0.06] shadow-[0_4px_24px_-2px_rgba(0,0,0,0.04)]"
      >
        <div
          class="text-xs font-semibold text-[#86868b] dark:text-[#a1a1a6] uppercase tracking-wider mb-2"
        >
          单款平均浏览
        </div>
        <div
          class="text-3xl font-black text-[#1d1d1f] dark:text-[#f5f5f7]"
          id="average-views"
        >
          -
        </div>
      </div>
    </div>

    <!-- 加载状态 -->
    <div id="ranking-loading" class="flex justify-center py-16">
      <LoadingSpinner size="lg" text="正在加载排行榜..." />
    </div>

    <!-- 错误状态 -->
    <div id="ranking-error" class="hidden">
      <ErrorMessage title="加载失败" message="无法加载排行榜数据，请稍后重试" />
      <div class="text-center mt-6">
        <button id="ranking-retry" class="px-6 py-2.5 rounded-full bg-[#0071e3] hover:bg-[#0077ed] text-white text-xs font-semibold shadow-sm hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"> 重新加载 </button>
      </div>
    </div>

    <!-- 排行榜容器 -->
    <div id="ranking-container" class="hidden">
      <!-- 动态排行榜卡片 -->
    </div>

    <!-- 分页容器 -->
    <div id="ranking-pagination" class="mt-8 flex justify-center"></div>
  </div>
</Layout>

<script>
  import { getApiClient } from "../lib/api";

  class RankingManager {
    private currentPage = 1;
    private pageSize = 20;
    private totalPages = 1;

    constructor() {
      this.init();
    }

    private init() {
      this.bindEvents();
      this.loadRanking();
    }

    private bindEvents() {
      const applyBtn = document.getElementById("apply-filters");
      const retryBtn = document.getElementById("ranking-retry");

      applyBtn?.addEventListener("click", () => {
        this.currentPage = 1;
        this.loadRanking();
      });

      retryBtn?.addEventListener("click", () => {
        this.loadRanking();
      });
    }

    private async loadRanking() {
      const container = document.getElementById("ranking-container");
      const loading = document.getElementById("ranking-loading");
      const errorElem = document.getElementById("ranking-error");
      const stats = document.getElementById("ranking-stats");

      if (!container || !loading || !errorElem) return;

      container.classList.add("hidden");
      errorElem.classList.add("hidden");
      loading.classList.remove("hidden");

      try {
        const api = getApiClient();
        const response = await api.getSoftwareRanking({
          page: this.currentPage,
          limit: this.pageSize,
          sortBy: "viewCount",
          sortOrder: "desc",
        });

        if (response.success && Array.isArray(response.data)) {
          this.renderRanking(response.data);

          if (stats) {
            stats.classList.remove("hidden");
            const totalSoftware = document.getElementById("total-software");
            const totalViews = document.getElementById("total-views");
            const avgViews = document.getElementById("average-views");

            if (totalSoftware)
              totalSoftware.textContent = response.data.length.toString();
            if (totalViews) {
              const total = response.data.reduce(
                (acc: number, curr: any) => acc + (curr.viewCount || 0),
                0,
              );
              totalViews.textContent = total.toLocaleString();
              if (avgViews)
                avgViews.textContent = Math.round(
                  total / (response.data.length || 1),
                ).toLocaleString();
            }
          }

          this.totalPages = 1;
          this.renderPagination();
          container.classList.remove("hidden");
        } else {
          throw new Error("获取数据失败");
        }
      } catch (error) {
        console.error("Load ranking error:", error);
        errorElem.classList.remove("hidden");
      } finally {
        loading.classList.add("hidden");
      }
    }

    private renderRanking(softwareList: any[]) {
      const container = document.getElementById("ranking-container");
      if (!container) return;

      container.innerHTML = `
      <div class="grid grid-cols-1 gap-5">
        ${softwareList
          .map((software, index) => {
            const rank =
              software.rank ||
              (this.currentPage - 1) * this.pageSize + index + 1;
            const isTop3 = rank <= 3;
            const rankStyles = [
              "bg-amber-500/15 text-amber-600 dark:text-amber-400 font-bold",
              "bg-slate-500/15 text-slate-600 dark:text-slate-300 font-bold",
              "bg-orange-500/15 text-orange-600 dark:text-orange-400 font-bold",
            ];

            return `
          <div class="group bg-white dark:bg-[#161617] rounded-2xl sm:rounded-3xl border border-black/[0.04] dark:border-white/[0.06] p-4 sm:p-6 shadow-[0_4px_24px_-2px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_40px_-12px_rgba(0,0,0,0.08)] dark:shadow-[0_8px_30px_rgba(0,0,0,0.5)] hover:-translate-y-1 transition-all duration-300 flex flex-row items-center sm:items-stretch gap-3.5 sm:gap-6 cursor-pointer" onclick="window.location.href='/software/${software.id}'">
            <!-- 排名与图标 -->
            <div class="flex items-center space-x-3 sm:space-x-5 flex-shrink-0">
              <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl sm:rounded-2xl ${isTop3 ? rankStyles[rank - 1] : "bg-black/[0.04] dark:bg-white/[0.06] text-[#86868b] dark:text-[#a1a1a6]"} flex items-center justify-center font-bold text-xs sm:text-sm shadow-sm transition-transform group-hover:scale-105 duration-200">
                ${rank}
              </div>
              
              <div class="flex-shrink-0">
                ${
                  software.icon
                    ? `<img src="${software.icon}" alt="${software.name}" class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl object-cover shadow-sm bg-black/[0.02] dark:bg-white/[0.05] border border-black/[0.04] dark:border-white/[0.08] transition-transform duration-200 group-hover:scale-105" />`
                    : `<div class="w-11 h-11 sm:w-14 sm:h-14 rounded-xl sm:rounded-2xl bg-black/[0.04] dark:bg-white/[0.08] flex items-center justify-center text-base sm:text-xl font-bold text-[#515154] dark:text-[#a1a1a6]">${software.name.charAt(0)}</div>`
                }
              </div>
            </div>

            <!-- 软件核心内容 -->
            <div class="flex-1 min-w-0 text-left flex flex-col justify-center">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <h3 class="text-base font-bold text-[#1d1d1f] dark:text-[#f5f5f7] truncate group-hover:text-[#0071e3] dark:group-hover:text-[#2997ff] transition-colors">
                    ${software.name}
                  </h3>
                  <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mt-1.5">
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold bg-[#e8f2fc] text-[#0071e3] dark:bg-[#2997ff]/15 dark:text-[#2997ff]">
                      v${software.currentVersion || "1.0"}
                    </span>
                    ${
                      software.category
                        ? `
                      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium bg-black/[0.04] text-[#515154] dark:bg-white/[0.08] dark:text-[#a1a1a6]">
                        ${software.category}
                      </span>
                    `
                        : ""
                    }
                  </div>
                  <p class="text-[#86868b] dark:text-[#a1a1a6] text-xs mt-2 line-clamp-2 leading-relaxed">
                    ${software.description || "探索更多软件特性与实用功能。"}
                  </p>
                </div>
                
                <div class="flex flex-col items-center sm:items-end gap-3 flex-shrink-0">
                  <span class="inline-flex items-center px-3 py-1 rounded-full bg-black/[0.03] dark:bg-white/[0.05] text-xs font-semibold text-[#86868b] dark:text-[#a1a1a6]">
                    <svg class="w-3.5 h-3.5 mr-1.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                    ${software.viewCount?.toLocaleString() || 0} 次查看
                  </span>
                  
                </div>
              </div>
            </div>
          `;
            })
            .join("")}
        </div>
      `;
      }

      private renderPagination() {
        const container = document.getElementById("ranking-pagination");
        if (!container || this.totalPages <= 1) {
          container?.classList.add("hidden");
          return;
        }

        const startPage = Math.max(1, this.currentPage - 2);
        const endPage = Math.min(this.totalPages, this.currentPage + 2);
        const pages = [];

        for (let i = startPage; i <= endPage; i++) {
          pages.push(i);
        }

        container.innerHTML = `
        <nav class="flex items-center space-x-2">
          ${
            this.currentPage > 1
              ? `
            <button onclick="rankingPage.goToPage(${this.currentPage - 1})" class="btn btn-outline btn-sm">
              上一页
            </button>
          `
              : ""
          }
          
          ${pages
            .map(
              (page) => `
            <button 
              onclick="rankingPage.goToPage(${page})" 
              class="btn ${page === this.currentPage ? "btn-primary" : "btn-outline"} btn-sm"
            >
              ${page}
            </button>
          `,
            )
            .join("")}
          
          ${
            this.currentPage < this.totalPages
              ? `
            <button onclick="rankingPage.goToPage(${this.currentPage + 1})" class="btn btn-outline btn-sm">
              下一页
            </button>
          `
              : ""
          }
        </nav>
      `;
      }

      public goToPage(page: number) {
        if (page >= 1 && page <= this.totalPages && page !== this.currentPage) {
          this.currentPage = page;
          this.loadRanking();
        }
      }
    }

    // 全局变量，供分页按钮调用
    let rankingPage: RankingPage;

    document.addEventListener("DOMContentLoaded", () => {
      rankingPage = new RankingPage();
    });
  </script>

  <style>
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>
</Layout>
