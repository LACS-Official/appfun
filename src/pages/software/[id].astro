        </div>

        <!-- 侧边栏规格卡片 (1列) -->
        <div class="lg:col-span-1">
          <div class="rounded-3xl bg-white dark:bg-[#161617] border border-black/[0.04] dark:border-white/[0.06] shadow-apple-card p-6 sticky top-24">
            <h3 class="text-base font-bold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7] mb-5">
              规格信息
            </h3>
            <dl class="space-y-3.5 text-xs">
              <div class="flex items-center justify-between py-2 border-b border-black/[0.04] dark:border-white/[0.06]">
                <dt class="text-[#86868b] dark:text-[#6e6e73]">当前版本</dt>
                <dd class="font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">v${software.currentVersion}</dd>
              </div>

              ${
                software.viewCount !== undefined
                  ? `
                <div class="flex items-center justify-between py-2 border-b border-black/[0.04] dark:border-white/[0.06]">
                  <dt class="text-[#86868b] dark:text-[#6e6e73]">热度浏览</dt>
                  <dd class="font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">${software.viewCount.toLocaleString()} 次</dd>
