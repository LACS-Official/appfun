              ${
                software.rank
                  ? `
                <div class="flex items-center justify-between py-2 border-b border-black/[0.04] dark:border-white/[0.06]">
                  <dt class="text-[#86868b] dark:text-[#6e6e73]">热门排名</dt>
                  <dd class="font-semibold text-amber-600 dark:text-amber-400">第 ${software.rank} 名</dd>
                </div>
              `
                  : ""
              }

              ${
                software.filetype
                  ? `
                <div class="flex items-center justify-between py-2 border-b border-black/[0.04] dark:border-white/[0.06]">
                  <dt class="text-[#86868b] dark:text-[#6e6e73]">文件格式</dt>
                  <dd class="font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] font-mono">${software.filetype.toUpperCase()}</dd>
                </div>
              `
                  : ""
              }

              ${
                software.openname
                  ? `
                <div class="flex items-center justify-between py-2 border-b border-black/[0.04] dark:border-white/[0.06]">
                  <dt class="text-[#86868b] dark:text-[#6e6e73]">启动文件</dt>
