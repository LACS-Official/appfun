---
import Layout from "../../layouts/Layout.astro";
import LoadingSpinner from "../../components/ui/LoadingSpinner.astro";
// 为静态生成提供路径
export async function getStaticPaths() {
  try {
    // 从API获取软件列表以获取所有ID
    const response = await fetch("https://api-g.lacs.cc/app/software");

    if (!response.ok) {
      throw new Error(`API请求失败: ${response.status}`);
    }

    const data = await response.json();

    // 检查响应数据格式
    if (!data.success || !data.data || !Array.isArray(data.data.software)) {
      throw new Error("API响应格式不正确");
    }

    // 从软件列表中提取ID
    const softwareIds = data.data.software.map((software: { id: number }) =>
      software.id.toString(),
    );

    // 为每个ID生成路径参数
    return softwareIds.map((id: string) => ({
      params: { id },
    }));
  } catch {
    // 如果API调用失败，使用备用ID列表确保至少能生成一些页面
    const fallbackIds = ["1", "2", "3"];
    return fallbackIds.map((id: string) => ({
      params: { id },
    }));
  }
}

const { id } = Astro.params;

if (!id || isNaN(Number(id))) {
  return Astro.redirect("/");
}

// SEO 元数据
const title = "软件详情";
const description =
  "查看软件的详细信息、版本历史和下载链接。在APPFUN上获取最新版本的软件，了解软件功能、大小、更新时间等详细信息";
const keywords = "软件详情,软件下载,软件版本,软件信息,APPFUN";
const canonical = `https://appfun.lacs.cc/software/${id}`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "",
  description: "",
  url: canonical,
  applicationCategory: "",
  operatingSystem: "",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "CNY",
  },
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  structuredDataType="software"
  structuredData={structuredData}
>
  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12"
  >
    <!-- 软件信息容器 -->
    <div id="software-container">
      <div class="flex justify-center py-20">
        <LoadingSpinner size="lg" text="正在加载软件信息..." />
      </div>
    </div>

    <!-- 版本历史 -->
    <section class="mt-12 md:mt-16" id="versions-section" style="display: none;">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7]">
            版本历史
          </h2>
          <p class="text-xs text-[#86868b] dark:text-[#a1a1a6] mt-0.5">查看版本迭代与更新日志</p>
        </div>
        <div class="flex items-center space-x-4">
          <select
            id="version-filter"
            class="border border-black/[0.08] dark:border-white/[0.1] rounded-full px-4 py-2 text-xs font-medium bg-white dark:bg-[#1c1c1e] text-[#1d1d1f] dark:text-[#f5f5f7] shadow-sm focus:outline-none focus:ring-2 focus:ring-[#0071e3] transition-all cursor-pointer"
          >
            <option value="all">所有版本</option>
            <option value="release">正式版</option>
            <option value="beta">测试版</option>
            <option value="alpha">内测版</option>
          </select>
        </div>
      </div>

      <div id="versions-container">
        <div class="flex justify-center py-10">
          <LoadingSpinner size="md" text="正在加载版本历史..." />
        </div>
      </div>
    </section>

    <!-- 公告 -->
    <section class="mt-12 md:mt-16" id="announcements-section" style="display: none;">
      <div class="mb-6">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7]">
          相关公告
        </h2>
        <p class="text-xs text-[#86868b] dark:text-[#a1a1a6] mt-0.5">软件重要通知与安全提醒</p>
      </div>
      <div id="announcements-container">
        <div class="flex justify-center py-10">
          <LoadingSpinner size="md" text="正在加载公告..." />
        </div>
      </div>
    </section>
  </div>
</Layout>

<script define:vars={{ id }} is:inline>
  // 由于这是在浏览器中运行的脚本，我们需要直接定义这些函数而不是导入
  // API 配置
  const apiConfig = {
    baseUrl: "https://api-g.lacs.cc",
    apiKey: "", // 暂时为空，因为API测试显示不需要API Key
    timeout: 10000,
  };

  // 全局变量，用于跟踪登录状态
  let globalLoginState = false;

  // 工具函数
  function formatDate(date, options = {}) {
    const dateObj = typeof date === "string" ? new Date(date) : date;
    const defaultOptions = {
      year: "numeric",
      month: "long",
      day: "numeric",
    };
    return dateObj.toLocaleDateString("zh-CN", {
      ...defaultOptions,
      ...options,
    });
  }

  function getPriorityDownloadLink(downloadLinks) {
    if (!downloadLinks) return null;
    const priorities = [
      "official",
      "github",
      "quark",
      "pan123",
      "baidu",
      "thunder",
    ];
    for (const priority of priorities) {
      if (downloadLinks[priority]) {
        return downloadLinks[priority];
      }
    }
    if (downloadLinks.backup && downloadLinks.backup.length > 0) {
      return downloadLinks.backup[0];
    }
    return null;
  }

  // API 客户端类
  class ApiClient {
    constructor(config) {
      this.config = {
        timeout: 10000,
        ...config,
      };
    }

    async request(endpoint, options = {}) {
      const url = `${this.config.baseUrl}${endpoint}`;
      const headers = {
        "Content-Type": "application/json",
        ...options.headers,
      };

      if (this.config.apiKey) {
        headers["X-API-Key"] = this.config.apiKey;
      }

      const controller = new AbortController();
      const timeoutId = setTimeout(
        () => controller.abort(),
        this.config.timeout,
      );

      try {
        const response = await fetch(url, {
          ...options,
          headers,
          signal: controller.signal,
        });

        clearTimeout(timeoutId);

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        return await response.json();
      } catch (error) {
        clearTimeout(timeoutId);
        if (error.name === "AbortError") {
          throw new Error("请求超时");
        }
        throw error;
      }
    }

    async get(endpoint, params) {
      const queryString = params ? new URLSearchParams(params).toString() : "";
      const url = queryString ? `${endpoint}?${queryString}` : endpoint;
      return this.request(url);
    }

    async getSoftwareById(id) {
      return this.get(`/app/software/id/${id}`);
    }

    async getSoftwareVersions(softwareId, params) {
      return this.get(`/app/software/id/${softwareId}/versions`, params);
    }

    async getSoftwareAnnouncements(softwareId, params) {
      return this.get(`/app/software/id/${softwareId}/announcements`, params);
    }
  }

  // 初始化全局登录状态检查
  async function checkGlobalLoginStatus() {
    try {
      // 1. 尝试通过 API 检查 (服务器端 Session)
      const response = await fetch("/api/auth/status");

      if (response.ok) {
        const data = await response.json();
        globalLoginState = !!data.user;
      } else {
        globalLoginState = false;
      }

      // 无论 API 成功还是失败，如果结果是未登录，都尝试从本地存储获取状态作为备份
      // 因为 Supabase 认证信息通常存储在 localStorage 中，而 API 可能因为 Cookie 未同步而返回未登录
      if (!globalLoginState) {
        const storedLoginState = localStorage.getItem("isLoggedIn") === "true";

        // 检查是否存在 Supabase 认证相关的 localStorage 项
        let hasSupabaseToken = false;
        try {
          for (let i = 0; i < localStorage.length; i++) {
            const key = localStorage.key(i);
            if (
              key &&
              (key.includes("-auth-token") ||
                key.includes("supabase.auth.token") ||
                key.startsWith("sb-"))
            ) {
              const val = localStorage.getItem(key);
              // 检查是否包含有效的 token 结构
              if (val && (val.includes("access_token") || val.includes("token"))) {
                hasSupabaseToken = true;
                break;
              }
            }
          }
        } catch (e) {
          console.warn("检查本地存储失败:", e);
        }

        globalLoginState = storedLoginState || hasSupabaseToken;

        // 如果本地检测到已登录，同步到状态变量，并确保本地标识位已设置
        if (globalLoginState) {
          localStorage.setItem("isLoggedIn", "true");
        }
      }
    } catch (error) {
      console.warn("API 状态检查异常:", error);
      // 网络错误等情况下，完全依赖本地存储
      const storedLoginState = localStorage.getItem("isLoggedIn") === "true";
      
      let hasSupabaseToken = false;
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && (key.includes("-auth-token") || key.startsWith("sb-"))) {
            const val = localStorage.getItem(key);
            if (val && val.includes("token")) {
              hasSupabaseToken = true;
              break;
            }
          }
        }
      } catch (e) {
        console.error("本地状态回退检查失败:", e);
      }
      
      globalLoginState = storedLoginState || hasSupabaseToken;
    }

    updateAllDownloadButtons();
    return globalLoginState;
  }

  // 更新所有下载按钮的状态
  function updateAllDownloadButtons() {
    const downloadButtons = document.querySelectorAll("[data-download-url]");
    downloadButtons.forEach((button) => {
      const downloadText = button.querySelector(".download-text");
      const loginPromptText = button.querySelector(".login-prompt-text");

      if (globalLoginState) {
        // 已登录状态 - 显示"立即下载"
        button.classList.remove("bg-[#ff9500]", "hover:bg-[#ff9f0a]", "bg-orange-500", "hover:bg-orange-600");
        button.classList.add("bg-[#0071e3]", "hover:bg-[#0077ed]");

        if (downloadText && loginPromptText) {
          downloadText.classList.remove("hidden");
          loginPromptText.classList.add("hidden");
        }
      } else {
        // 未登录状态 - 显示"请登录后下载"
        button.classList.remove("bg-[#0071e3]", "hover:bg-[#0077ed]", "bg-blue-600", "hover:bg-blue-700");
        button.classList.add("bg-[#ff9500]", "hover:bg-[#ff9f0a]");

        if (downloadText && loginPromptText) {
          downloadText.classList.add("hidden");
          loginPromptText.classList.remove("hidden");
        }
      }
    });
  }

  // 页面加载时检查登录状态
  checkGlobalLoginStatus();

  // 初始化 API 客户端
  const apiClient = new ApiClient(apiConfig);

  let softwareData = null;
  let currentVersionFilter = "all";

  document.addEventListener("DOMContentLoaded", async () => {
    // 确保在加载详情前先获取最新的登录状态
    await checkGlobalLoginStatus();
    loadSoftwareDetails(id);
    setupEventListeners();
  });

  // 设置事件监听器
  function setupEventListeners() {
    const versionFilter = document.getElementById("version-filter");
    if (versionFilter) {
      versionFilter.addEventListener("change", (e) => {
        currentVersionFilter = e.target.value;
        loadVersions();
      });
    }
  }

  // 加载软件详情
  async function loadSoftwareDetails(id) {
    const container = document.getElementById("software-container");
    if (!container) {
      return;
    }

    try {
      const response = await apiClient.getSoftwareById(parseInt(id));
      if (response.success && response.data) {
        softwareData = response.data;
        renderSoftwareDetails(softwareData);

        // 显示其他部分
        document.getElementById("versions-section").style.display = "block";
        document.getElementById("announcements-section").style.display =
          "block";

        // 加载版本历史和公告
        loadVersions();
        loadAnnouncements();
      } else {
        throw new Error(response.message || "软件不存在");
      }
    } catch (error) {
      container.innerHTML = `
        <div class="text-center py-12">
          <div class="text-red-500 text-6xl mb-4">⚠️</div>
          <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">加载失败</h3>
          <p class="text-gray-500 dark:text-gray-400 mb-4">${error.message || "无法加载软件信息，请稍后重试"}</p>
          <div class="space-x-4">
            <button onclick="loadSoftwareDetails(id)" class="btn btn-primary">
              重新加载
            </button>
            <a href="/" class="btn btn-outline border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">
              返回首页
            </a>
          </div>
        </div>
      `;
    }
  }

  // 渲染软件详情
  function renderSoftwareDetails(software) {
    const container = document.getElementById("software-container");
    if (!container) {
      return;
    }

    const downloadUrl =
      software.latestDownloadUrl ||
      getPriorityDownloadLink(software.versions?.[0]?.downloadLinks);
    const systemReqs = software.systemRequirements;

    container.innerHTML = `
      <!-- 面包屑导航 -->
      <nav class="flex items-center space-x-2 text-xs font-medium text-[#86868b] dark:text-[#a1a1a6] mb-6">
        <a href="/" class="hover:text-[#0071e3] dark:hover:text-[#2997ff] transition-colors">首页</a>
        <svg class="w-3 h-3 text-[#86868b] dark:text-[#6e6e73]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        ${
          software.category
            ? `
          <a href="/software?category=${encodeURIComponent(software.category)}" class="hover:text-[#0071e3] dark:hover:text-[#2997ff] transition-colors">${software.category}</a>
          <svg class="w-3 h-3 text-[#86868b] dark:text-[#6e6e73]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        `
            : ""
        }
        <span class="text-[#1d1d1f] dark:text-[#f5f5f7] truncate max-w-xs">${software.name}</span>
      </nav>

      <!-- 软件核心 Hero 卡片 (Apple App Store 风格) -->
      <div class="rounded-3xl bg-white dark:bg-[#161617] border border-black/[0.04] dark:border-white/[0.06] shadow-apple-card p-6 sm:p-8 md:p-10 mb-8 transition-all">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="flex items-start sm:items-center space-x-5">
            <!-- 软件图标 -->
            <div class="flex-shrink-0">
              ${
                software.icon
                  ? `
                <img
                  src="${software.icon}"
                  alt="${software.name}"
                  class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl sm:rounded-3xl object-cover shadow-sm bg-black/[0.02] dark:bg-white/[0.05] border border-black/[0.04] dark:border-white/[0.08]"
                />
              `
                  : `
                <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl sm:rounded-3xl bg-[#f5f5f7] dark:bg-[#1c1c1e] text-[#1d1d1f] dark:text-[#f5f5f7] flex items-center justify-center text-3xl font-bold shadow-sm border border-black/[0.04] dark:border-white/[0.08]">
                  ${software.name.charAt(0)}
                </div>
              `
              }
            </div>

            <!-- 软件基本信息 -->
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-1.5">
                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7]">
                  ${software.name}
                </h1>
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold bg-[#e8f2fc] text-[#0071e3] dark:bg-[#2997ff]/15 dark:text-[#2997ff]">
                  v${software.currentVersion}
                </span>
                ${
                  software.category
                    ? `
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-black/[0.04] text-[#515154] dark:bg-white/[0.08] dark:text-[#a1a1a6]">
                    ${software.category}
                  </span>
                `
                    : ""
                }
              </div>

              ${
                software.nameEn
                  ? `<p class="text-sm sm:text-base text-[#86868b] dark:text-[#a1a1a6] mb-3">${software.nameEn}</p>`
                  : ""
              }

              ${
                software.tags && software.tags.length > 0
                  ? `
                <div class="flex flex-wrap gap-1.5 mt-2">
                  ${software.tags
                    .map(
                      (tag) => `
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium bg-black/[0.03] text-[#515154] dark:bg-white/[0.06] dark:text-[#a1a1a6]">
                      #${tag}
                    </span>
                  `,
                    )
                    .join("")}
                </div>
              `
                  : ""
              }
            </div>
          </div>

          <!-- 操作按钮区域 (Apple Pill 按钮) -->
          <div class="flex items-center flex-wrap gap-3 pt-2 md:pt-0">
            ${
              downloadUrl
                ? `
              <button
                id="main-download-button"
                class="inline-flex items-center justify-center font-medium px-8 py-3.5 rounded-full text-white text-sm shadow-sm transition-all duration-200 active:scale-[0.98] ${globalLoginState ? "bg-[#0071e3] hover:bg-[#0077ed]" : "bg-[#ff9500] hover:bg-[#ff9f0a]"}"
                data-download-url="${globalLoginState ? downloadUrl : ""}"
                data-show-login-prompt="true"
                type="button">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                <span class="download-text ${globalLoginState ? "" : "hidden"}">立即获取</span>
                <span class="login-prompt-text ${globalLoginState ? "hidden" : ""}">登录后下载</span>
              </button>
            `
                : ""
            }
            
            ${
              software.officialWebsite
                ? `
              <a href="${software.officialWebsite}" target="_blank" rel="noopener noreferrer" 
                 class="inline-flex items-center justify-center font-medium px-6 py-3.5 rounded-full text-sm bg-black/[0.04] hover:bg-black/[0.08] dark:bg-white/[0.06] dark:hover:bg-white/[0.12] text-[#1d1d1f] dark:text-[#f5f5f7] border border-black/[0.04] dark:border-white/[0.08] transition-all duration-200 active:scale-[0.98]">
                <svg class="w-4 h-4 mr-1.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
                官方网站
              </a>
            `
                : ""
            }
          </div>
        </div>
      </div>

      <!-- 详情与规格双栏布局 -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- 主要内容区 (2列) -->
        <div class="lg:col-span-2 space-y-8">
          <!-- 软件介绍 -->
          <div class="rounded-3xl bg-white dark:bg-[#161617] border border-black/[0.04] dark:border-white/[0.06] shadow-apple-card p-6 sm:p-8">
            <h3 class="text-lg font-bold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7] mb-4">
              软件介绍
            </h3>
            <div class="text-sm leading-relaxed text-[#515154] dark:text-[#a1a1a6] space-y-3">
              <p class="whitespace-pre-line">${software.description || "暂无软件详细介绍"}</p>
              ${software.descriptionEn ? `<p class="mt-4 pt-4 border-t border-black/[0.04] dark:border-white/[0.06] text-[#86868b] dark:text-[#6e6e73] whitespace-pre-line">${software.descriptionEn}</p>` : ""}
            </div>
          </div>

          <!-- 系统要求 -->
          ${
            systemReqs
              ? `
            <div class="rounded-3xl bg-white dark:bg-[#161617] border border-black/[0.04] dark:border-white/[0.06] shadow-apple-card p-6 sm:p-8">
              <h3 class="text-lg font-bold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7] mb-4">
                系统要求
              </h3>
              <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                ${
                  systemReqs.os
                    ? `
                  <div class="p-4 rounded-2xl bg-black/[0.02] dark:bg-white/[0.03] border border-black/[0.03] dark:border-white/[0.04]">
                    <dt class="text-xs font-medium text-[#86868b] dark:text-[#6e6e73]">操作系统</dt>
                    <dd class="mt-1 text-sm font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">${Array.isArray(systemReqs.os) ? systemReqs.os.join(", ") : systemReqs.os}</dd>
                  </div>
                `
                    : ""
                }
                ${
                  systemReqs.memory
                    ? `
                  <div class="p-4 rounded-2xl bg-black/[0.02] dark:bg-white/[0.03] border border-black/[0.03] dark:border-white/[0.04]">
                    <dt class="text-xs font-medium text-[#86868b] dark:text-[#6e6e73]">运行内存</dt>
                    <dd class="mt-1 text-sm font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">${systemReqs.memory}</dd>
                  </div>
                `
                    : ""
                }
                ${
                  systemReqs.storage
                    ? `
                  <div class="p-4 rounded-2xl bg-black/[0.02] dark:bg-white/[0.03] border border-black/[0.03] dark:border-white/[0.04]">
                    <dt class="text-xs font-medium text-[#86868b] dark:text-[#6e6e73]">存储空间</dt>
                    <dd class="mt-1 text-sm font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">${systemReqs.storage}</dd>
                  </div>
                `
                    : ""
                }
              </dl>
            </div>
          `
              : ""
