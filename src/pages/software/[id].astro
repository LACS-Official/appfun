              <div class="flex items-center justify-between py-2 border-b border-black/[0.04] dark:border-white/[0.06]">
                <dt class="text-[#86868b] dark:text-[#6e6e73]">更新日期</dt>
                <dd class="text-[#1d1d1f] dark:text-[#f5f5f7]">${formatDate(software.updatedAt)}</dd>
              </div>

              <div class="flex items-center justify-between pt-2">
                <dt class="text-[#86868b] dark:text-[#6e6e73]">入库时间</dt>
                <dd class="text-[#1d1d1f] dark:text-[#f5f5f7]">${formatDate(software.createdAt)}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    `;

    // 更新页面标题
    document.title = `${software.name} - APPFUN`;

    // 初始化下载按钮
    initializeDownloadButtons();
  }

  // 加载版本历史
  async function loadVersions() {
    const container = document.getElementById("versions-container");
    if (!container || !softwareData) return;

    container.innerHTML = `
      <div class="flex justify-center py-8">
        <div class="animate-spin w-6 h-6 border-2 border-[#0071e3] border-t-transparent rounded-full"></div>
      </div>
    `;

    try {
      const params = {
        page: 1,
        limit: 10,
        sortBy: "releaseDate",
        sortOrder: "desc",
      };

      if (currentVersionFilter !== "all") {
        params.versionType = currentVersionFilter;
      }

      const response = await apiClient.getSoftwareVersions(
        softwareData.id,
        params,
      );

      if (response.success && response.data) {
        const versions = response.data.versions || response.data;

        if (versions.length === 0) {
          container.innerHTML = `
            <div class="text-center py-10 rounded-3xl bg-white dark:bg-[#161617] border border-black/[0.04] dark:border-white/[0.06]">
              <p class="text-xs text-[#86868b] dark:text-[#a1a1a6]">暂无符合条件的版本历史</p>
            </div>
          `;
          return;
        }

        container.innerHTML = `
          <div class="space-y-4">
            ${versions
              .map(
                (version) => `
              <div class="bg-white dark:bg-[#161617] rounded-3xl border border-black/[0.04] dark:border-white/[0.06] shadow-apple-card hover:shadow-apple-card-hover transition-all duration-200 p-6">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <h4 class="text-base font-bold text-[#1d1d1f] dark:text-[#f5f5f7]">v${version.version}</h4>
                    <p class="text-xs text-[#86868b] dark:text-[#6e6e73] mt-0.5">${formatDate(version.releaseDate)}</p>
                  </div>
                  <div class="flex items-center space-x-2">
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium ${
                      version.versionType === "release"
                        ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                        : version.versionType === "beta"
                          ? "bg-amber-500/10 text-amber-600 dark:text-amber-400"
                          : "bg-rose-500/10 text-rose-600 dark:text-rose-400"
                    }">
                      ${
                        version.versionType === "release"
                          ? "正式版"
                          : version.versionType === "beta"
                            ? "测试版"
                            : "内测版"
                      }
                    </span>
                    ${
                      version.isStable
                        ? `
                      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold bg-[#e8f2fc] text-[#0071e3] dark:bg-[#2997ff]/15 dark:text-[#2997ff]">
                        稳定版
                      </span>
                    `
                        : ""
                    }
                  </div>
                </div>
                
                ${
                  version.releaseNotes
                    ? `
                  <div class="mt-3 pt-3 border-t border-black/[0.04] dark:border-white/[0.06]">
                    <h5 class="text-xs font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] mb-1.5">更新日志</h5>
                    <p class="text-xs leading-relaxed text-[#515154] dark:text-[#a1a1a6] whitespace-pre-line">${version.releaseNotes}</p>
                  </div>
                `
                    : ""
                }
              </div>
            `,
              )
              .join("")}
          </div>
        `;
      }
    } catch {
      container.innerHTML = `
        <div class="text-center py-8">
          <p class="text-xs text-rose-500">版本历史加载失败，请稍后重试</p>
        </div>
      `;
    }
  }

