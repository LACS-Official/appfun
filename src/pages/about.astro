<script>
  // 网站统计数据获取和显示
  document.addEventListener("DOMContentLoaded", async () => {
    const totalPageviewsEl = document.getElementById("total-pageviews");
    const uniqueVisitorsEl = document.getElementById("unique-visitors");
    const todayPageviewsEl = document.getElementById("today-pageviews");
    const activeVisitorsEl = document.getElementById("active-visitors");
    const lastUpdatedEl = document.getElementById("last-updated");

    // 格式化数字显示
    function formatNumber(num: number): string {
      if (num >= 10000) {
        return (num / 1000).toFixed(1) + "K";
      }
      return num.toLocaleString();
    }

    // 获取统计数据
    async function fetchStats() {
      try {
        // 调用统计数据 API
        const response = await fetch("/api/umami/stats");

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        const result = await response.json();

        if (!result.success) {
          throw new Error(result.message || "获取统计数据失败");
        }

        const stats = result.data;

        // 更新显示
        if (totalPageviewsEl)
          totalPageviewsEl.textContent = formatNumber(stats.totalPageviews);
        if (uniqueVisitorsEl)
          uniqueVisitorsEl.textContent = formatNumber(stats.uniqueVisitors);
        if (todayPageviewsEl)
          todayPageviewsEl.textContent = formatNumber(stats.todayPageviews);
        if (activeVisitorsEl)
          activeVisitorsEl.textContent = stats.activeVisitors.toString();

        // 更新时间
        if (lastUpdatedEl) {
          const updateTime = new Date(stats.lastUpdated);
          lastUpdatedEl.textContent = updateTime.toLocaleString("zh-CN");
        }

        console.log("统计数据已更新:", stats);
      } catch (error: any) {
        console.error("获取统计数据失败:", error?.message);

        // 显示错误状态
        if (totalPageviewsEl) totalPageviewsEl.textContent = "--";
        if (uniqueVisitorsEl) uniqueVisitorsEl.textContent = "--";
        if (todayPageviewsEl) todayPageviewsEl.textContent = "--";
        if (activeVisitorsEl) activeVisitorsEl.textContent = "--";
        if (lastUpdatedEl) lastUpdatedEl.textContent = "获取失败";
      }
    }

    // 初始加载
    await fetchStats();

    // 每30秒更新一次数据
    setInterval(fetchStats, 30000);
  });

  // Umami 事件跟踪（如果需要）
  function trackEvent(eventName: string, eventData: Record<string, any> = {}) {
    if (window.umami && typeof window.umami.track === "function") {
      window.umami.track(eventName, eventData);
    }
  }

  // 跟踪页面停留时间
  let startTime = Date.now();
  window.addEventListener("beforeunload", () => {
    const timeSpent = Math.round((Date.now() - startTime) / 1000);
    trackEvent("page-time", { duration: timeSpent, page: "about" });
  });
</script>
