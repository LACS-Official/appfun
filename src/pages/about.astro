---
import Layout from "../layouts/Layout.astro";
import Card from "../components/ui/Card.astro";
import { appConfig } from "../lib/config";

const title = "关于我们";
const description =
  "了解APPFUN的使命、愿景和团队。APPFUN是一个致力于为用户提供优质软件管理和分发服务的平台，让软件发现和使用变得简单高效";
const keywords = "关于APPFUN,APPFUN介绍,软件平台,领创工作室,软件管理,软件分发";
const canonical = "https://appfun.lacs.cc/about";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: title,
  description: description,
  url: canonical,
  mainEntity: {
    "@type": "Organization",
    name: "领创工作室",
    url: "https://appfun.lacs.cc",
    description: "致力于为用户提供优质的软件管理和分发服务",
  },
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  structuredDataType="website"
  structuredData={structuredData}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- 页面标题 -->
    <div class="text-center mb-14">
      <h1 class="text-4xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-3">关于我们</h1>
      <p class="text-lg text-neutral-500 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
        致力于为用户提供优质的软件管理和分发服务，让软件发现和使用变得简单高效
      </p>
    </div>

    <!-- 网站统计数据 -->
    <section class="mb-16">
      <div class="bg-white dark:bg-[#1c1c1e] rounded-3xl shadow-apple-card border border-black/[0.04] dark:border-white/[0.06] p-6 sm:p-8">
        <div class="text-center mb-8">
          <h2 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-1.5">网站统计</h2>
          <p class="text-sm text-neutral-500 dark:text-neutral-400">实时访问数据统计</p>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          <!-- 总访问量 -->
          <div
            class="text-center p-5 sm:p-6 bg-neutral-50/80 dark:bg-white/[0.03] rounded-2xl border border-black/[0.03] dark:border-white/[0.04]"
          >
            <div
              class="w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-950/40 text-primary-600 dark:text-primary-400 flex items-center justify-center mx-auto mb-3"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.8"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.8"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                ></path>
              </svg>
            </div>
            <div
              class="text-2xl font-semibold text-neutral-900 dark:text-white mb-1 tracking-tight"
              id="total-pageviews"
            >
              <div class="animate-pulse bg-neutral-200 dark:bg-neutral-700 h-7 w-16 mx-auto rounded-lg">
              </div>
            </div>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">总访问量</p>
          </div>

          <!-- 独立访客 -->
          <div
            class="text-center p-5 sm:p-6 bg-neutral-50/80 dark:bg-white/[0.03] rounded-2xl border border-black/[0.03] dark:border-white/[0.04]"
          >
            <div
              class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mx-auto mb-3"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.8"
                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"
                ></path>
              </svg>
            </div>
            <div
              class="text-2xl font-semibold text-neutral-900 dark:text-white mb-1 tracking-tight"
              id="unique-visitors"
            >
              <div class="animate-pulse bg-neutral-200 dark:bg-neutral-700 h-7 w-16 mx-auto rounded-lg">
              </div>
            </div>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">独立访客</p>
          </div>

          <!-- 今日访问 -->
          <div
            class="text-center p-5 sm:p-6 bg-neutral-50/80 dark:bg-white/[0.03] rounded-2xl border border-black/[0.03] dark:border-white/[0.04]"
          >
            <div
              class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center mx-auto mb-3"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.8"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <div
              class="text-2xl font-semibold text-neutral-900 dark:text-white mb-1 tracking-tight"
              id="today-pageviews"
            >
              <div class="animate-pulse bg-neutral-200 dark:bg-neutral-700 h-7 w-16 mx-auto rounded-lg">
              </div>
            </div>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">今日访问</p>
          </div>

          <!-- 在线用户 -->
          <div
            class="text-center p-5 sm:p-6 bg-neutral-50/80 dark:bg-white/[0.03] rounded-2xl border border-black/[0.03] dark:border-white/[0.04]"
          >
            <div
              class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center mx-auto mb-3"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.8"
                  d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-2.829a5 5 0 010-7.07m7.072 0a5 5 0 010 7.07M13 12a1 1 0 11-2 0 1 1 0 012 0z"
                ></path>
              </svg>
            </div>
            <div
              class="text-2xl font-semibold text-neutral-900 dark:text-white mb-1 tracking-tight"
              id="active-visitors"
            >
              <div class="animate-pulse bg-neutral-200 dark:bg-neutral-700 h-7 w-16 mx-auto rounded-lg">
              </div>
            </div>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">在线用户</p>
          </div>
        </div>

        <!-- 数据更新时间 -->
        <div class="text-center mt-6 pt-5 border-t border-black/[0.04] dark:border-white/[0.06]">
          <p class="text-xs text-neutral-400 dark:text-neutral-500">
            数据更新时间：<span id="last-updated" class="font-medium text-neutral-600 dark:text-neutral-400"
              >加载中...</span
            >
          </p>
        </div>
      </div>
    </section>

    <!-- 平台介绍 -->
    <section class="mb-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div>
          <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-white mb-5">我们的平台</h2>
          <div class="space-y-4 text-neutral-600 dark:text-neutral-300 leading-relaxed text-sm sm:text-base">
            <p>
              {appConfig.title} 是一个基于现代技术栈构建的软件管理与分发服务平台，旨在为开发者和用户提供便捷的软件发布、管理和下载服务。
            </p>
            <p>
              我们使用 Astro 框架构建前端界面，集成了高可用 API 服务，为用户提供纯净、流畅的软件浏览体验。
            </p>
            <p>
              平台支持多端软件分类、标签索引、版本记录、激活码分配等功能，满足多样化的日常与专业需求。
            </p>
          </div>
        </div>

        <div class="bg-neutral-50/80 dark:bg-white/[0.03] rounded-3xl p-8 border border-black/[0.04] dark:border-white/[0.06] text-center">
          <div
            class="w-16 h-16 bg-primary-600 text-white rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-sm"
          >
            <svg
              class="w-8 h-8"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-neutral-900 dark:text-white mb-1.5">
            {appConfig.title}
          </h3>
          <p class="text-sm text-neutral-500 dark:text-neutral-400">版本 {appConfig.version}</p>
        </div>
      </div>
    </section>

    <!-- 核心功能 -->
    <section class="mb-16">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-white text-center mb-10">
        核心功能
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <Card class="p-6">
          <div class="w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-950/40 text-primary-600 dark:text-primary-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-white mb-2">软件管理</h3>
          <p class="text-neutral-500 dark:text-neutral-400 text-sm leading-relaxed">
            完整的软件信息管理，包括版本历史、下载链接、系统要求等详细信息
          </p>
        </Card>

        <Card class="p-6">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-white mb-2">分类标签</h3>
          <p class="text-neutral-500 dark:text-neutral-400 text-sm leading-relaxed">
            灵活的分类和标签系统，帮助用户快速找到所需的软件工具
          </p>
        </Card>

        <Card class="p-6">
          <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-white mb-2">激活码管理</h3>
          <p class="text-neutral-500 dark:text-neutral-400 text-sm leading-relaxed">
            强大的激活码生成、验证和管理功能，支持软件许可证管理
          </p>
        </Card>

        <Card class="p-6">
          <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-white mb-2">数据统计</h3>
          <p class="text-neutral-500 dark:text-neutral-400 text-sm leading-relaxed">
            详细的用户行为统计和软件使用分析，帮助了解软件使用情况
          </p>
        </Card>

        <Card class="p-6">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-white mb-2">智能搜索</h3>
          <p class="text-neutral-500 dark:text-neutral-400 text-sm leading-relaxed">
            强大的搜索功能，支持按名称、分类、标签等多种方式查找软件
          </p>
        </Card>

        <Card class="p-6">
          <div class="w-10 h-10 rounded-xl bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-base font-semibold text-neutral-900 dark:text-white mb-2">响应式设计</h3>
          <p class="text-neutral-500 dark:text-neutral-400 text-sm leading-relaxed">
            完美适配桌面和移动设备，随时随地访问和管理软件
          </p>
        </Card>
      </div>
    </section>

    <!-- 技术栈 -->
    <section class="mb-16">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-white text-center mb-10">技术栈</h2>
      <div class="bg-white dark:bg-[#1c1c1e] rounded-3xl border border-black/[0.04] dark:border-white/[0.06] shadow-apple-card p-6 sm:p-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
          <div class="text-center p-4">
            <div
              class="w-12 h-12 bg-orange-50 dark:bg-orange-950/40 rounded-2xl flex items-center justify-center mx-auto mb-3"
            >
              <svg
                class="w-6 h-6 text-orange-600 dark:text-orange-400"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 0L1.608 4.8L3.072 19.2L12 24l8.928-4.8L21.392 4.8L12 0z"
                ></path>
              </svg>
            </div>
            <h3 class="font-medium text-neutral-900 dark:text-white text-sm sm:text-base mb-0.5">Astro</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400">现代静态站点生成器</p>
          </div>

          <div class="text-center p-4">
            <div
              class="w-12 h-12 bg-blue-50 dark:bg-blue-950/40 rounded-2xl flex items-center justify-center mx-auto mb-3"
            >
              <svg
                class="w-6 h-6 text-blue-600 dark:text-blue-400"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M14.23 12.004a2.236 2.236 0 0 1-2.235 2.236 2.236 2.236 0 0 1-2.236-2.236 2.236 2.236 0 0 1 2.235-2.236 2.236 2.236 0 0 1 2.236 2.236zm2.648-10.69c-1.346 0-3.107.96-4.888 2.622-1.78-1.653-3.542-2.602-4.887-2.602-.41 0-.783.093-1.106.278-1.375.793-1.683 3.264-.973 6.365C1.98 8.917 0 10.42 0 12.004c0 1.59 1.99 3.097 5.043 4.03-.704 3.113-.39 5.588.988 6.38.32.187.69.275 1.102.275 1.345 0 3.107-.96 4.888-2.624 1.78 1.654 3.542 2.603 4.887 2.603.41 0 .783-.09 1.106-.275 1.374-.792 1.683-3.263.973-6.365C22.02 15.096 24 13.59 24 12.004c0-1.59-1.99-3.097-5.043-4.032.704-3.11.39-5.587-.988-6.38-.318-.184-.688-.277-1.092-.278zm-.005 1.09v.006c.225 0 .406.044.558.127.666.382.955 1.835.73 3.704-.054.46-.142.945-.25 1.44-.96-.236-2.006-.417-3.107-.534-.66-.905-1.345-1.727-2.035-2.447 1.592-1.48 3.087-2.292 4.105-2.295zm-9.77.02c1.012 0 2.514.808 4.11 2.28-.686.72-1.37 1.537-2.02 2.442-1.107.117-2.154.298-3.113.538-.112-.49-.195-.964-.254-1.42-.23-1.868.054-3.32.714-3.707.19-.09.4-.127.563-.132zm4.882 3.05c.455.468.91.992 1.36 1.564-.44-.02-.89-.034-1.36-.034-.47 0-.92.014-1.36.034.44-.572.895-1.096 1.36-1.564zM12 8.1c.74 0 1.477.034 2.202.093.406.582.802 1.203 1.183 1.86.372.64.71 1.29 1.018 1.946-.308.655-.646 1.31-1.013 1.95-.38.66-.773 1.288-1.18 1.87-.728.063-1.466.098-2.21.098-.74 0-1.477-.035-2.202-.093-.406-.582-.802-1.204-1.183-1.86-.372-.64-.71-1.29-1.018-1.946.303-.657.646-1.313 1.013-1.954.38-.66.773-1.286 1.18-1.868.728-.064 1.466-.099 2.21-.099zm-3.635.254c-.24.377-.48.763-.704 1.16-.225.39-.435.782-.635 1.174-.265-.656-.49-1.31-.676-1.947.64-.15 1.315-.283 2.015-.386zm7.26 0c.695.103 1.365.23 2.006.387-.18.632-.405 1.282-.66 1.933-.2-.39-.41-.783-.64-1.174-.225-.392-.465-.774-.705-1.146zm3.063.675c.484.15.944.317 1.375.498 1.732.74 2.852 1.708 2.852 2.476-.005.768-1.125 1.74-2.857 2.475-.42.18-.88.342-1.355.493-.28-.958-.646-1.956-1.1-2.98.45-1.017.81-2.01 1.085-2.964zm-13.395.004c.278.96.645 1.957 1.1 2.98-.45 1.017-.812 2.01-1.086 2.964-.484-.15-.944-.318-1.37-.5-1.732-.737-2.852-1.706-2.852-2.474 0-.768 1.12-1.742 2.852-2.476.42-.18.88-.342 1.356-.494zm11.678 4.28c.265.657.49 1.312.676 1.948-.64.157-1.316.29-2.016.39.24-.375.48-.762.705-1.158.225-.39.435-.788.636-1.18zm-9.945.02c.2.392.41.783.64 1.175.23.39.465.772.705 1.143-.695-.102-1.365-.23-2.006-.386.18-.63.406-1.282.66-1.933zM17.92 16.32c.112.493.2.968.254 1.423.23 1.868-.054 3.32-.714 3.708-.147.09-.338.128-.563.128-1.012 0-2.514-.807-4.11-2.28.686-.72 1.37-1.536 2.02-2.44 1.107-.118 2.154-.3 3.113-.54zm-11.83.01c.96.234 2.006.415 3.107.532.66.905 1.345 1.727 2.035 2.446-1.595 1.483-3.092 2.295-4.11 2.295-.22-.005-.406-.05-.553-.132-.666-.38-.955-1.834-.73-3.703.054-.46.142-.944.25-1.438zm4.56.64c.44.02.89.034 1.36.034.47 0 .92-.014 1.36-.034-.44.572-.895 1.095-1.36 1.56-.465-.467-.92-.988-1.36-1.56z"
                ></path>
              </svg>
            </div>
            <h3 class="font-medium text-neutral-900 dark:text-white text-sm sm:text-base mb-0.5">React</h3>
            <p class="text-xs text-neutral-500 dark:text-neutral-400">交互式组件开发</p>
          </div>

          <div class="text-center p-4">
            <div
              class="w-12 h-12 bg-cyan-50 dark:bg-cyan-950/40 rounded-2xl flex items-center justify-center mx-auto mb-3"
            >
              <svg
                class="w-6 h-6 text-cyan-600 dark:text-cyan-400"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
